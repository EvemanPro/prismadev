# Cloudflare Pages applies these to every response.
# Caching is left to Pages, which purges the edge automatically on deploy.
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=(), interest-cohort=()

# Self-hosted fonts. The file names carry a version (.v1), so a changed font
# ships under a new name and these can be cached for a year.
/fonts/*
  Cache-Control: public, max-age=31536000, immutable
